{
  "name": "aharos",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "RESTORA — The Operating System for Restaurants",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:cafe": "tsx prisma/seed-coders-cafe.ts",
    "db:studio": "prisma studio",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:pg:schema": "node scripts/pg-schema.mjs",
    "db:pg:deploy": "node scripts/pg-schema.mjs && prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "test:pg": "node scripts/pg-schema.mjs && prisma generate --schema prisma/postgres/schema.prisma && vitest run",
    "e2e": "npm run build && playwright test",
    "e2e:test": "playwright test",
    "e2e:investor": "playwright test -c playwright.investor.config.ts",
    "desktop:build": "node desktop/scripts/build.mjs",
    "desktop:start": "electron build/desktop/app",
    "desktop:pack": "node desktop/scripts/build.mjs && electron-builder --dir --publish never",
    "desktop:dist": "node desktop/scripts/build.mjs && electron-builder --win --publish never",
    "desktop:dist:mac": "node desktop/scripts/build.mjs && electron-builder --mac --publish never",
    "desktop:verify": "tsx desktop/scripts/verify-package.ts",
    "desktop:e2e": "playwright test -c playwright.desktop.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "15.5.27",
    "qrcode": "1.5.4",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
