// ============================================================
// Aharos — Restaurant Operating System
// Prisma schema
//
// DATABASE STRATEGY
// - Local dev: SQLite (zero external services). See note below.
// - Production: PostgreSQL (+ Row Level Security). Switch `provider`
//   to "postgresql" and point DATABASE_URL at Postgres. The schema is
//   written to be portable (see DATABASE.md).
//
// TENANCY ANCHORS (RLS-ready)
// - Every business row carries scalar `organizationId` (and `outletId`
//   where operational). These are the columns Postgres RLS policies
//   filter on, so they are denormalized onto every row on purpose and
//   indexed. Enforcement today lives in the data-access layer
//   (src/server/db/scope.ts); in production the same columns back RLS.
//
// ACTORS
// - `createdById` / actor columns reference User.id as indexed scalars
//   (traceability without a fragile mega back-relation on User). Auth-
//   critical relations (Session, Membership) are formal FKs.
//
// IMMUTABILITY
// - InventoryLedger, AuditLog, LoyaltyTransaction, PettyCashTxn and
//   Payment are append-only. Mistakes are fixed with CORRECTION rows
//   (self-relations correctionOfId / reversedById), never edits/deletes.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local: sqlite. Production: change to "postgresql".
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANCY & IDENTITY
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  gstin     String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets     Outlet[]
  memberships Membership[]
  users       User[]

  @@index([active])
}

model Outlet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  name           String
  address        String?
  gstin          String?
  phone          String?
  currency       String       @default("INR")
  timezone       String       @default("Asia/Kolkata")
  openTime       String? // "09:00"
  closeTime      String? // "23:30"
  // Invoice number series prefix (≤ 4 chars), e.g. "HYD" -> HYD/2627/00001.
  invoiceSeries  String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments Department[]
  floors      Floor[]
  memberships Membership[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  outlet         Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name           String
  kind           String   @default("OTHER") // STORE | KITCHEN | BAR | BAKERY | PRODUCTION | OTHER
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([outletId, name])
  @@index([organizationId])
  @@index([outletId, kind])
}

model User {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email                String
  name                 String
  passwordHash         String
  phone                String?
  active               Boolean      @default(true)
  isSuperAdmin         Boolean      @default(false)
  lastLoginAt          DateTime?
  // Owner recovery key (H2): SHA-256 of a 150-bit key shown to the Owner once.
  // Only active org-wide OWNERs hold one; it rotates on every successful use.
  recoveryKeyHash      String?
  recoveryKeyCreatedAt DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  memberships    Membership[]
  sessions       Session[]
  passwordTokens PasswordToken[]

  @@unique([email])
  @@index([organizationId, active])
}

// A user's role at a specific outlet (outletId null => organization-wide role).
model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outletId       String?
  outlet         Outlet?      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  // OWNER | AREA_MANAGER | ADMIN | MANAGER | STORE | KITCHEN | CAPTAIN | CASHIER | CUSTOMER | SUPER_ADMIN
  role           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, outletId, role])
  @@index([organizationId])
  @@index([outletId])
  @@index([userId, active])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  ip              String?
  userAgent       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  // Idle timeout (H3): last meaningful activity (null = createdAt). Written at
  // most once a minute; background polling never advances it.
  lastActivityAt  DateTime?
  // Step-up re-authentication grant: one scope, short-lived, bound to this session.
  reauthScope     String?
  reauthExpiresAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// One-time password setup (new staff) / reset links. Only the SHA-256 of the
// token is stored; a token is single-use (usedAt) and expires.
model PasswordToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        String // SETUP | RESET
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([organizationId])
}

// ============================================================
// MASTER DATA
// ============================================================

model Unit {
  id             String   @id @default(cuid())
  organizationId String
  code           String // "kg", "g", "L", "ml", "pc"
  name           String
  kind           String   @default("COUNT") // WEIGHT | VOLUME | COUNT
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  materials     Material[]        @relation("MaterialBaseUnit")
  ledgerEntries InventoryLedger[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// Unit conversions. materialId null => global conversion (e.g. 1 kg = 1000 g).
model UnitConversion {
  id             String   @id @default(cuid())
  organizationId String
  fromUnitId     String
  toUnitId       String
  factor         Decimal // 1 fromUnit = factor * toUnit
  materialId     String? // material-specific override (e.g. 1 crate = 24 pc)
  createdAt      DateTime @default(now())

  @@unique([organizationId, fromUnitId, toUnitId, materialId])
  @@index([organizationId])
  @@index([materialId])
}

model MaterialCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  materials Material[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Material {
  id                String            @id @default(cuid())
  organizationId    String
  sku               String
  name              String
  categoryId        String?
  category          MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUnitId        String
  baseUnit          Unit              @relation("MaterialBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  purchaseUnitId    String?
  taxPct            Decimal           @default(0)
  minStock          Decimal           @default(0)
  reorderLevel      Decimal           @default(0)
  preferredVendorId String?
  perishable        Boolean           @default(false)
  trackBatch        Boolean           @default(false)
  active            Boolean           @default(true)
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ledgerEntries InventoryLedger[]
  vendorLinks   VendorMaterial[]
  outletCosts   OutletMaterialCost[]
  recipeLines   RecipeLine[]         @relation("RecipeLineMaterial")

  @@unique([organizationId, sku])
  @@index([organizationId, active])
  @@index([categoryId])
  @@index([baseUnitId])
}

// Weighted-average cost is per outlet (purchases differ by outlet).
model OutletMaterialCost {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  materialId     String
  material       Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  avgCost        Decimal  @default(0) // weighted-average unit cost in base unit
  lastCost       Decimal  @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([outletId, materialId])
  @@index([organizationId])
  @@index([materialId])
}

// ============================================================
// VENDORS
// ============================================================

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?
  gstin          String?
  bankAccount    String?
  bankIfsc       String?
  paymentTerms   String? // "NET15", "COD"
  creditLimit    Decimal  @default(0)
  active         Boolean  @default(true)
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  materials VendorMaterial[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model VendorMaterial {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  materialId     String
  material       Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  lastRate       Decimal  @default(0)
  leadTimeDays   Int      @default(1)
  preferred      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([vendorId, materialId])
  @@index([organizationId])
  @@index([materialId])
}

// ============================================================
// MENU
// ============================================================

model MenuCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items MenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MenuItem {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String?
  category       MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  price          Decimal       @default(0)
  taxPct         Decimal       @default(5)
  station        String        @default("KITCHEN") // routing hint for KOT: KITCHEN | BAR | BAKERY
  posCode        String? // external POS item code for mapping
  // HSN / SAC code for tax invoices (restaurant service: SAC 996331).
  hsnSac         String?
  isVeg          Boolean       @default(true)
  active         Boolean       @default(true)
  soldOut        Boolean       @default(false)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants        MenuItemVariant[]
  modifierGroups  MenuItemModifierGroup[]
  recipe          Recipe?                 @relation("MenuItemRecipe")
  orderItems      OrderItem[]
  outletOverrides OutletMenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@index([organizationId, posCode])
  @@index([categoryId])
}

// Per-outlet menu overrides. Absent row => the org-level MenuItem values apply.
model OutletMenuItem {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  price          Decimal? // null => MenuItem.price
  active         Boolean  @default(true) // false => not offered at this outlet
  soldOut        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@unique([outletId, menuItemId])
  @@index([organizationId])
  @@index([menuItemId])
}

model MenuItemVariant {
  id                String   @id @default(cuid())
  organizationId    String
  menuItemId        String
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name              String // "Half", "Full"
  priceDelta        Decimal  @default(0)
  // Inventory: this variant consumes this multiple of the item's recipe (Half = 0.5, Large = 1.5).
  consumptionFactor Decimal  @default(1)
  active            Boolean  @default(true)

  @@unique([menuItemId, name])
  @@index([organizationId])
}

model ModifierGroup {
  id             String  @id @default(cuid())
  organizationId String
  name           String // "Spice Level", "Add-ons"
  minSelect      Int     @default(0)
  maxSelect      Int     @default(1)
  active         Boolean @default(true)

  options   ModifierOption[]
  menuItems MenuItemModifierGroup[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ModifierOption {
  id             String        @id @default(cuid())
  organizationId String
  groupId        String
  group          ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name           String
  priceDelta     Decimal       @default(0)
  // Inventory: an add-on that uses stock (e.g. extra cheese = 30 g of Cheese per unit ordered).
  materialId     String?
  materialQty    Decimal?
  unitId         String?
  active         Boolean       @default(true)

  @@unique([groupId, name])
  @@index([organizationId])
}

model MenuItemModifierGroup {
  id         String        @id @default(cuid())
  menuItemId String
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, groupId])
  @@index([groupId])
}

// ============================================================
// RECIPES (recursive, versioned)
// ============================================================

model Recipe {
  id               String    @id @default(cuid())
  organizationId   String
  // A recipe produces either a menu item or a stockable sub-recipe material.
  outputType       String    @default("MENU_ITEM") // MENU_ITEM | SUB_RECIPE
  menuItemId       String?   @unique
  menuItem         MenuItem? @relation("MenuItemRecipe", fields: [menuItemId], references: [id], onDelete: Cascade)
  outputMaterialId String? // for SUB_RECIPE: the produced (semi-finished) material
  name             String
  active           Boolean   @default(true)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  versions    RecipeVersion[]
  // Lines in OTHER recipes that reference this recipe as a sub-recipe.
  usedInLines RecipeLine[]    @relation("RecipeLineSubRecipe")

  @@index([organizationId, active])
  @@index([outputMaterialId])
}

model RecipeVersion {
  id             String    @id @default(cuid())
  organizationId String
  recipeId       String
  recipe         Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version        Int       @default(1)
  status         String    @default("DRAFT") // DRAFT | APPROVED | ARCHIVED
  effectiveFrom  DateTime  @default(now())
  yieldQty       Decimal   @default(1)
  yieldUnitId    String?
  servingSize    Decimal   @default(1)
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  lines RecipeLine[]

  @@unique([recipeId, version])
  @@index([organizationId])
  @@index([recipeId, status])
}

model RecipeLine {
  id              String        @id @default(cuid())
  organizationId  String
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  componentType   String // MATERIAL | SUB_RECIPE
  materialId      String?
  material        Material?     @relation("RecipeLineMaterial", fields: [materialId], references: [id], onDelete: Restrict)
  subRecipeId     String?
  subRecipe       Recipe?       @relation("RecipeLineSubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)
  qty             Decimal
  unitId          String?
  wastagePct      Decimal       @default(0)
  sortOrder       Int           @default(0)

  @@index([recipeVersionId])
  @@index([organizationId])
  @@index([materialId])
  @@index([subRecipeId])
}

// ============================================================
// TABLES & FLOORS
// ============================================================

model Floor {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  outlet         Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  tables RestaurantTable[]

  @@unique([outletId, name])
  @@index([organizationId])
}

model RestaurantTable {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  floorId        String?
  floor          Floor?   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  code           String // "T1"
  capacity       Int      @default(4)
  status         String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | ORDERING | PREPARING | READY | BILL_REQUESTED | BILLED | RESERVED | CLEANING
  qrToken        String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]

  @@unique([outletId, code])
  @@index([organizationId, outletId])
  @@index([outletId, status])
  @@index([floorId])
}

// ============================================================
// CUSTOMERS / CRM / LOYALTY
// ============================================================

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  birthday       DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses    CustomerAddress[]
  loyalty      LoyaltyAccount?
  loyaltyTxns  LoyaltyTransaction[]
  orders       Order[]
  reservations Reservation[]
  feedback     Feedback[]

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model CustomerAddress {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String   @default("Home")
  line1          String
  line2          String?
  city           String?
  pincode        String?
  lat            Float?
  lng            Float?

  @@index([customerId])
}

model LoyaltyAccount {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String   @unique
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier           String   @default("SILVER")
  // Balance is a cache; the ledger (LoyaltyTransaction) is the source of truth.
  pointsBalance  Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Append-only loyalty ledger. Never edit a balance directly.
model LoyaltyTransaction {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type           String // EARN | REDEEM | EXPIRE | ADJUST
  points         Int // signed: + earn, - redeem/expire
  orderId        String?
  note           String?
  actorId        String?
  createdAt      DateTime @default(now())

  // Idempotency: at most one EARN (or REDEEM / reversal ADJUST) per customer per
  // order. NULL orderIds (manual adjustments) are distinct, so they are unaffected.
  @@unique([customerId, orderId, type])
  @@index([organizationId])
  @@index([customerId])
}

model Feedback {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId        String?
  rating         Int       @default(5)
  comment        String?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([customerId])
}

model Reservation {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tableId        String?
  partySize      Int       @default(2)
  reservedAt     DateTime
  status         String    @default("BOOKED") // BOOKED | CONFIRMED | SEATED | COMPLETED | CANCELLED | NO_SHOW
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, outletId])
  @@index([outletId, reservedAt])
  @@index([customerId])
}

// Table occupancy locks: one row per (table, 15-minute slot) held by an active
// reservation. The unique constraint makes concurrent double-booking impossible
// at the database level on SQLite and PostgreSQL alike (see reservations.ts).
model ReservationSlot {
  id             String   @id @default(cuid())
  organizationId String
  tableId        String
  slot           DateTime // slot start (UTC, aligned to 15 minutes)
  reservationId  String
  createdAt      DateTime @default(now())

  @@unique([tableId, slot])
  @@index([reservationId])
  @@index([organizationId])
}

model WaitlistEntry {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  customerName   String
  phone          String?
  partySize      Int      @default(2)
  status         String   @default("WAITING") // WAITING | ARRIVED | SEATED | LEFT | CANCELLED
  estWaitMins    Int      @default(15)
  createdAt      DateTime @default(now())

  @@index([organizationId, outletId, status])
}

// ============================================================
// ORDERS / POS / BILLING / PAYMENTS
// ============================================================

model Order {
  id             String           @id @default(cuid())
  organizationId String
  outletId       String
  channel        String           @default("DINE_IN") // DINE_IN | TAKEAWAY | DELIVERY | QR | ONLINE | AGGREGATOR
  source         String           @default("POS") // POS | QR | ONLINE | PETPOOJA | MANUAL | ZOMATO | SWIGGY
  // Idempotency: (outletId, source, externalRef) is unique so a re-delivered
  // POS/webhook order cannot create a duplicate. See webhook + reconciliation.
  externalRef    String?
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         String           @default("OPEN") // OPEN | SENT | PREPARING | READY | SERVED | BILLED | PAID | CANCELLED | REFUNDED
  invoiceNo      String?
  subtotal       Decimal          @default(0)
  discount       Decimal          @default(0)
  tax            Decimal          @default(0)
  total          Decimal          @default(0)
  // Set true exactly once when the recipe explosion has depleted stock,
  // guarding against double consumption at the aggregate level.
  stockConsumed  Boolean          @default(false)
  covers         Int              @default(1)
  notes          String?
  // Client-supplied Idempotency-Key for order creation: a retry returns the
  // original order; reuse with a different request is rejected (requestHash).
  idempotencyKey String?
  requestHash    String?
  // B2B buyer details for the tax invoice (set before the invoice is issued).
  buyerGstin     String?
  buyerName      String?
  createdById    String?
  billedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items    OrderItem[]
  payments Payment[]
  kots     Kot[]
  rounds   OrderRound[]

  @@unique([outletId, invoiceNo])
  @@unique([outletId, source, externalRef])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, createdAt])
  @@index([outletId, status])
  @@index([customerId])
  @@index([tableId, status])
}

model OrderItem {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  posItemCode    String? // captured even when unmapped
  // The menu variant ordered (drives its recipe consumption factor).
  variantId      String?
  name           String // snapshot of item name at time of order
  qty            Decimal   @default(1)
  unitPrice      Decimal   @default(0)
  discount       Decimal   @default(0)
  taxPct         Decimal   @default(0)
  lineTotal      Decimal   @default(0)
  // HSN / SAC snapshot at order time.
  hsnSac         String?
  station        String    @default("KITCHEN")
  notes          String?
  createdAt      DateTime  @default(now())

  modifiers OrderItemModifier[]
  kotItems  KotItem[]

  @@index([orderId])
  @@index([organizationId, outletId])
  @@index([menuItemId])
}

/// One "round" of items added to a running order (captain / POS) with its
/// Idempotency-Key: a retried round returns the original instead of adding the
/// lines twice. The lines themselves are ordinary OrderItems.
model OrderRound {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  itemCount      Int      @default(0)
  fired          Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([orderId])
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  name        String
  // The configured option ordered (drives add-on stock consumption).
  optionId    String?
  priceDelta  Decimal   @default(0)

  @@index([orderItemId])
}

// Append-only payment record. Refunds are separate rows; success is set
// server-side only (never trusted from the client). See PaymentProvider.
model Payment {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method         String // CASH | UPI | CARD | WALLET | ONLINE | OTHER
  status         String    @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED | PARTIAL
  amount         Decimal
  providerRef    String?
  provider       String? // mock | razorpay | stripe
  verifiedAt     DateTime?
  actorId        String?
  /// Client Idempotency-Key: a retried creation returns this payment instead of a second one.
  idempotencyKey String?
  requestHash    String?
  createdAt      DateTime  @default(now())

  refunds Refund[]

  /// Provider references are only unique within one tenant (two restaurants' POS/gateway accounts may reuse ids).
  @@unique([organizationId, provider, providerRef])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, createdAt])
  @@index([orderId])
}

model Refund {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount         Decimal
  reason         String?
  // Client-supplied key so a retried refund request cannot post twice.
  idempotencyKey String?
  // Gateway refund id (refund executed at / reported by the payment provider).
  providerRef    String?
  actorId        String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, providerRef])
  @@index([paymentId])
  @@index([organizationId, outletId])
}

// ============================================================
// KOT / KDS
// ============================================================

model KitchenStation {
  id             String  @id @default(cuid())
  organizationId String
  outletId       String
  name           String // "Main Kitchen", "Bar"
  kind           String  @default("KITCHEN")
  active         Boolean @default(true)

  kots Kot[]

  @@unique([outletId, name])
  @@index([organizationId, outletId])
}

model Kot {
  id             String          @id @default(cuid())
  organizationId String
  outletId       String
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stationId      String?
  station        KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  number         Int
  status         String          @default("NEW") // NEW | ACCEPTED | PREPARING | READY | SERVED | CANCELLED
  printedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items KotItem[]

  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
  @@index([orderId])
  @@index([stationId])
}

model KotItem {
  id          String     @id @default(cuid())
  kotId       String
  kot         Kot        @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  name        String
  qty         Decimal    @default(1)
  status      String     @default("NEW")
  notes       String?

  @@index([kotId])
  @@index([orderItemId]) // "is this line on a KOT?" — without it every round/bill read seq-scanned KotItem (SSI relation lock)
}

// ============================================================
// PROCUREMENT (procure-to-pay)
// ============================================================

model PurchaseIndent {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  number         String
  departmentId   String?
  status         String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | CLOSED | CANCELLED
  notes          String?
  createdById    String?
  approvedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines PurchaseIndentLine[]

  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
}

model PurchaseIndentLine {
  id             String         @id @default(cuid())
  organizationId String
  indentId       String
  indent         PurchaseIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  unitId         String?

  @@index([indentId])
}

model PurchaseOrder {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  number         String
  vendorId       String
  status         String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | ORDERED | PARTIAL | RECEIVED | BILLED | CLOSED | CANCELLED
  expectedDate   DateTime?
  subtotal       Decimal   @default(0)
  tax            Decimal   @default(0)
  total          Decimal   @default(0)
  notes          String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  // The approved indent this PO was raised from (raising the PO closes it).
  indentId       String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([indentId])
  @@index([organizationId, outletId, status])
  @@index([vendorId])
}

model PurchaseOrderLine {
  id             String        @id @default(cuid())
  organizationId String
  poId           String
  po             PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  rate           Decimal
  taxPct         Decimal       @default(0)
  receivedQty    Decimal       @default(0)
  unitId         String?

  @@index([poId])
  @@index([materialId])
}

model GoodsReceipt {
  id             String         @id @default(cuid())
  organizationId String
  outletId       String
  number         String
  poId           String?
  po             PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  vendorId       String
  status         String         @default("DRAFT") // DRAFT | POSTED (posting writes the inventory ledger)
  receivedAt     DateTime       @default(now())
  notes          String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  createdById    String?
  postedAt       DateTime?
  createdAt      DateTime       @default(now())

  lines GoodsReceiptLine[]
  bills PurchaseBill[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
  @@index([vendorId])
  @@index([poId])
}

model GoodsReceiptLine {
  id             String       @id @default(cuid())
  organizationId String
  grnId          String
  grn            GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  rate           Decimal
  damagedQty     Decimal      @default(0)
  batchNo        String?
  expiryDate     DateTime?
  unitId         String?

  @@index([grnId])
  @@index([materialId])
}

model PurchaseBill {
  id              String        @id @default(cuid())
  organizationId  String
  outletId        String
  number          String
  vendorId        String
  grnId           String?
  grn             GoodsReceipt? @relation(fields: [grnId], references: [id], onDelete: SetNull)
  billDate        DateTime      @default(now())
  dueDate         DateTime?
  subtotal        Decimal       @default(0)
  tax             Decimal       @default(0)
  total           Decimal       @default(0)
  paidAmount      Decimal       @default(0)
  status          String        @default("OPEN") // OPEN | PARTIAL | PAID | CANCELLED
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey  String?
  requestHash     String?
  // The vendor's own invoice number: at most one bill per vendor invoice.
  vendorInvoiceNo String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines    PurchaseBillLine[]
  payments VendorPayment[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, vendorId, vendorInvoiceNo])
  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
  @@index([vendorId])
  @@index([grnId])
}

model PurchaseBillLine {
  id             String       @id @default(cuid())
  organizationId String
  billId         String
  bill           PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  rate           Decimal
  taxPct         Decimal      @default(0)

  @@index([billId])
}

model VendorPayment {
  id             String        @id @default(cuid())
  organizationId String
  outletId       String
  vendorId       String
  billId         String?
  bill           PurchaseBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  amount         Decimal
  method         String        @default("BANK") // CASH | BANK | UPI | CHEQUE
  reference      String?
  // Client-supplied key so a retried payment request cannot post twice.
  idempotencyKey String?
  paidAt         DateTime      @default(now())
  actorId        String?
  // Reversal (bounced cheque / returned transfer): the payment stops counting
  // against its bill; the row is kept.
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime      @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId])
  @@index([vendorId])
  @@index([billId])
}

// ============================================================
// INVENTORY LEDGER (append-only — the single source of truth)
// ============================================================

model InventoryLedger {
  id             String            @id @default(cuid())
  organizationId String
  outletId       String
  departmentId   String?
  materialId     String
  material       Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  unitId         String?
  unit           Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  // OPENING_BALANCE | PURCHASE_RECEIPT | SALE_CONSUMPTION | ISSUE |
  // TRANSFER_OUT | TRANSFER_IN | PRODUCTION_CONSUMPTION | PRODUCTION_OUTPUT |
  // WASTAGE | SPOILAGE | STAFF_MEAL | COUNT_ADJUSTMENT | RETURN | OTHER_ADJUSTMENT
  txnType        String
  // Signed quantity in base unit: positive = stock in, negative = stock out.
  qty            Decimal
  rate           Decimal           @default(0) // unit cost at time of movement
  amount         Decimal           @default(0) // qty * rate (signed)
  // Provenance
  sourceType     String? // GRN | ORDER | TRANSFER | ISSUE | WASTAGE | COUNT | PRODUCTION | MANUAL
  sourceId       String?
  // Idempotency guard: a unique source reference means the same business
  // event can never write two consumption rows. Duplicate webhook => no-op.
  sourceRef      String?           @unique
  batchNo        String?
  expiryDate     DateTime?
  note           String?
  // Correction chain (append-only): a mistake is fixed with a new row.
  correctionOfId String?
  correctionOf   InventoryLedger?  @relation("LedgerCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections    InventoryLedger[] @relation("LedgerCorrection")
  actorId        String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, outletId, materialId])
  @@index([materialId, createdAt])
  @@index([outletId, txnType])
  @@index([sourceType, sourceId])
  @@index([correctionOfId])
}

// ============================================================
// STOCK OPERATIONS (each posts to the ledger)
// ============================================================

model InventoryTransfer {
  id             String    @id @default(cuid())
  organizationId String
  number         String
  fromOutletId   String
  toOutletId     String
  status         String    @default("DRAFT") // DRAFT | DISPATCHED | RECEIVED | CANCELLED
  notes          String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  createdById    String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())

  lines InventoryTransferLine[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([fromOutletId])
  @@index([toOutletId])
}

model InventoryTransferLine {
  id             String            @id @default(cuid())
  organizationId String
  transferId     String
  transfer       InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  materialId     String
  requestedQty   Decimal
  dispatchedQty  Decimal           @default(0)
  receivedQty    Decimal           @default(0)
  damagedQty     Decimal           @default(0)
  unitId         String?

  @@index([transferId])
  @@index([materialId])
}

model InventoryIssue {
  id               String    @id @default(cuid())
  organizationId   String
  outletId         String
  number           String
  fromDepartmentId String?
  toDepartmentId   String?
  status           String    @default("DRAFT") // DRAFT | ISSUED | CANCELLED
  notes            String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey   String?
  requestHash      String?
  createdById      String?
  issuedAt         DateTime?
  createdAt        DateTime  @default(now())

  lines InventoryIssueLine[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
}

model InventoryIssueLine {
  id             String         @id @default(cuid())
  organizationId String
  issueId        String
  issue          InventoryIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  unitId         String?

  @@index([issueId])
  @@index([materialId])
}

model Wastage {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  departmentId   String?
  number         String
  reason         String   @default("SPOILAGE") // SPOILAGE | SPILLAGE | PREP_LOSS | EXPIRED | DAMAGED | STAFF_MEAL | OVERPRODUCTION | OTHER
  status         String   @default("POSTED") // DRAFT | POSTED | CANCELLED (posting writes the ledger)
  notes          String?
  // Client Idempotency-Key for creation: a retry with the same key + request
  // returns the original document; reuse for a different request is refused.
  idempotencyKey String?
  requestHash    String?
  createdById    String?
  createdAt      DateTime @default(now())

  lines WastageLine[]

  @@unique([organizationId, idempotencyKey])
  @@unique([outletId, number])
  @@index([organizationId, outletId])
}

model WastageLine {
  id             String  @id @default(cuid())
  organizationId String
  wastageId      String
  wastage        Wastage @relation(fields: [wastageId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal
  estCost        Decimal @default(0)
  unitId         String?

  @@index([wastageId])
  @@index([materialId])
}

model StockCount {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  departmentId   String?
  number         String
  status         String    @default("DRAFT") // DRAFT | COUNTING | REVIEW | APPROVED | CANCELLED
  frozenAt       DateTime? // when book quantities were snapshotted
  approvedById   String?
  approvedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines StockCountLine[]

  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
}

model StockCountLine {
  id             String     @id @default(cuid())
  organizationId String
  countId        String
  count          StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  materialId     String
  bookQty        Decimal    @default(0) // frozen snapshot — never overwritten after approval
  physicalQty    Decimal    @default(0)
  variance       Decimal    @default(0)
  costImpact     Decimal    @default(0)
  unitId         String?

  @@index([countId])
  @@index([materialId])
}

model ProductionBatch {
  id               String    @id @default(cuid())
  organizationId   String
  outletId         String
  number           String
  recipeVersionId  String?
  outputMaterialId String
  plannedQty       Decimal
  actualQty        Decimal   @default(0)
  batchNo          String?
  expiryDate       DateTime?
  status           String    @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETED | CANCELLED
  createdById      String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  lines ProductionLine[]

  @@unique([outletId, number])
  @@index([organizationId, outletId, status])
}

model ProductionLine {
  id             String          @id @default(cuid())
  organizationId String
  batchId        String
  batch          ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Decimal // consumed input quantity
  unitId         String?

  @@index([batchId])
  @@index([materialId])
}

// ============================================================
// FINANCE
// ============================================================

model Expense {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  category       String // RENT | UTILITIES | SALARY | REPAIRS | MISC ...
  amount         Decimal
  description    String?
  paidVia        String    @default("CASH") // CASH | BANK | UPI | PETTY_CASH
  attachmentUrl  String?
  spentAt        DateTime  @default(now())
  // Client Idempotency-Key: a retried submission returns the original row.
  idempotencyKey String?
  requestHash    String?
  // Void (correction): voided expenses leave every total; the row is kept.
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, spentAt])
}

// Append-only petty-cash ledger.
model PettyCashTxn {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  type           String // OPENING | ADD | EXPENSE | ADJUST
  amount         Decimal // signed: + in, - out
  category       String?
  reason         String?
  attachmentUrl  String?
  approvedById   String?
  actorId        String?
  // Client Idempotency-Key: a retried submission returns the original row.
  idempotencyKey String?
  requestHash    String?
  // The expense this movement paid (a voided expense posts an opposite movement).
  expenseId      String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, outletId, createdAt])
}

model CashDrawerSession {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  openedById     String?
  openingFloat   Decimal   @default(0)
  closingCount   Decimal?
  status         String    @default("OPEN") // OPEN | CLOSED
  // Frozen at close: expected = float + net cash sales + pay-ins − pay-outs.
  expectedCash   Decimal?
  variance       Decimal?
  closedById     String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  movements CashDrawerMovement[]

  @@index([organizationId, outletId, status])
}

model Reconciliation {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  businessDate   DateTime
  // PAYMENTS (counted collections per method) | POS (provider orders vs local)
  // | GATEWAY (payment provider vs local payments) | AGGREGATOR (settlements vs
  // expected payouts) | VENDOR (bills vs vendor payments)
  kind           String   @default("PAYMENTS")
  status         String   @default("DRAFT") // DRAFT | COMPLETED (completed = locked)
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines ReconciliationLine[]

  @@unique([outletId, businessDate, kind])
  @@index([organizationId, outletId])
}

model ReconciliationLine {
  id               String         @id @default(cuid())
  organizationId   String
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  // PAYMENTS: the payment method. Other kinds: the compared item's reference
  // (e.g. "order:<externalRef>", "payment:<providerRef>", "bill:<number>", "TOTAL").
  method           String
  expected         Decimal        @default(0)
  actual           Decimal        @default(0)
  difference       Decimal        @default(0)
  note             String?

  @@index([reconciliationId])
}

// ============================================================
// AGGREGATORS
// ============================================================

model Aggregator {
  id             String  @id @default(cuid())
  organizationId String
  name           String // ZOMATO | SWIGGY | ...
  commissionPct  Decimal @default(0)
  active         Boolean @default(true)

  orders      AggregatorOrder[]
  settlements AggregatorSettlement[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AggregatorOrder {
  id             String     @id @default(cuid())
  organizationId String
  outletId       String
  aggregatorId   String
  aggregator     Aggregator @relation(fields: [aggregatorId], references: [id], onDelete: Cascade)
  externalId     String
  orderId        String? // linked internal order
  grossAmount    Decimal    @default(0)
  discount       Decimal    @default(0)
  commission     Decimal    @default(0)
  tax            Decimal    @default(0)
  platformFee    Decimal    @default(0)
  netPayout      Decimal    @default(0)
  placedAt       DateTime   @default(now())

  @@unique([aggregatorId, externalId])
  @@index([organizationId, outletId])
}

model AggregatorSettlement {
  id             String     @id @default(cuid())
  organizationId String
  outletId       String
  aggregatorId   String
  aggregator     Aggregator @relation(fields: [aggregatorId], references: [id], onDelete: Cascade)
  periodFrom     DateTime
  periodTo       DateTime
  expectedPayout Decimal    @default(0)
  actualPayout   Decimal    @default(0)
  difference     Decimal    @default(0)
  createdAt      DateTime   @default(now())

  @@index([organizationId, outletId])
  @@index([aggregatorId])
}

// ============================================================
// PEOPLE
// ============================================================

model Attendance {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  userId         String
  checkIn        DateTime
  checkOut       DateTime?
  status         String    @default("PRESENT") // PRESENT | LATE | ABSENT | LEAVE
  note           String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, outletId, userId])
  @@index([userId, checkIn])
}

model Shift {
  id             String @id @default(cuid())
  organizationId String
  outletId       String
  name           String
  startTime      String // "09:00"
  endTime        String // "17:00"

  @@index([organizationId, outletId])
}

model LeaveRequest {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  userId         String
  fromDate       DateTime
  toDate         DateTime
  reason         String?
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedById   String?
  createdAt      DateTime @default(now())

  @@index([organizationId, outletId, userId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  title          String
  description    String?
  assignedToId   String?
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | VERIFIED | CANCELLED
  dueAt          DateTime?
  completedById  String?
  completedAt    DateTime?
  verifiedById   String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, outletId, status])
  @@index([assignedToId])
}

// ============================================================
// INTEGRATIONS / SYSTEM / OBSERVABILITY
// ============================================================

// Idempotency + audit for inbound webhooks (POS, payments, aggregators).
model WebhookEvent {
  id             String    @id @default(cuid())
  organizationId String?
  provider       String // petpooja | razorpay | zomato | ...
  eventId        String // provider's unique event/order id
  eventType      String?
  signatureValid Boolean   @default(false)
  status         String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | DUPLICATE
  payload        String // raw JSON
  error          String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  // The core idempotency guard for inbound events.
  @@unique([provider, eventId])
  @@index([status])
  @@index([provider, receivedAt])
}

// POS items sold with no recipe mapping — surfaced, never silently dropped.
model UnmappedSale {
  id               String    @id @default(cuid())
  organizationId   String
  outletId         String
  posCode          String
  posName          String?
  qty              Decimal   @default(0)
  source           String    @default("POS")
  status           String    @default("OPEN") // OPEN | MAPPED | IGNORED
  mappedMenuItemId String?
  resolvedById     String?
  resolvedAt       DateTime?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  @@unique([outletId, source, posCode])
  @@index([organizationId, outletId, status])
}

model IntegrationConnection {
  id               String    @id @default(cuid())
  organizationId   String
  outletId         String?
  kind             String // POS | PAYMENT | AGGREGATOR | SHEETS | WHATSAPP | EMAIL
  provider         String
  status           String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  // Config holds NON-secret settings only.
  config           String? // JSON
  /// The provider's identifier for THIS tenant's account/store (Petpooja restID,
  /// aggregator store id, gateway merchant account id). Inbound webhooks are
  /// bound to a tenant ONLY through this mapping — never through ids in the body.
  externalRef      String?
  /// Optional per-tenant webhook signing secret, AES-256-GCM encrypted
  /// (server/integrations/secrets.ts). When set, the deployment-wide provider
  /// secret is NOT accepted for this tenant.
  webhookSecretEnc String?
  /// SANDBOX | LIVE — what the operator declared; adapters that cannot reach a
  /// live provider never report LIVE (see docs/phase7-integrations.md).
  mode             String    @default("SANDBOX")
  /// Provider API credentials (JSON), AES-256-GCM encrypted. Write-only.
  credentialsEnc   String?
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  /// Safe, secret-free message of the last failure.
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, outletId, kind, provider])
  /// One provider account maps to exactly one tenant.
  @@unique([kind, provider, externalRef])
  @@index([organizationId])
}

model SyncJob {
  id             String    @id @default(cuid())
  organizationId String
  kind           String // SHEETS_PUSH | SHEETS_PULL | RECONCILE
  status         String    @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED
  direction      String? // PUSH | PULL
  detail         String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, kind, status])
}

model ExportJob {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  kind           String // report id: DAILY_SALES | ITEM_SALES | INVENTORY | PNL | ...
  format         String    @default("CSV")
  status         String    @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED | EXPIRED (EXPORT_TRANSITIONS)
  filePath       String? // opaque storage key "<orgId>/<jobId>.csv" (never a filesystem path, never sent to clients); null = inline CSV / purged
  params         String? // JSON of the validated filters (no secrets)
  rowCount       Int?
  error          String? // safe, user-facing message only (internal errors are logged, not stored)
  requestedById  String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime? // claimed by a runner (PENDING -> RUNNING)
  finishedAt     DateTime? // SUCCESS / FAILED
  expiresAt      DateTime? // stored file is removed after this (EXPORT_RETENTION_HOURS)
  purgedAt       DateTime? // SUCCESS -> EXPIRED by retention cleanup

  @@index([organizationId, kind])
  @@index([status, createdAt])
}

model Anomaly {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  departmentId   String?
  type           String // NEGATIVE_STOCK | COUNT_VARIANCE | PRICE_SPIKE | UNMAPPED_ITEM | HEAVY_WASTAGE
  severity       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  entityType     String?
  entityId       String?
  message        String
  status         String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | DISMISSED
  resolvedById   String?
  resolutionNote String?
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, outletId, status])
  @@index([type, severity])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  userId         String? // null => broadcast to org/outlet
  channel        String    @default("IN_APP") // IN_APP | EMAIL | WHATSAPP | PUSH
  type           String
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  reads NotificationRead[]

  @@index([organizationId, outletId])
  @@index([userId, readAt])
}

/// Per-user read receipt for a BROADCAST notification (userId = null on the
/// notification). Personal notifications keep using Notification.readAt.
model NotificationRead {
  id             String       @id @default(cuid())
  organizationId String
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([organizationId, userId])
}

// Append-only audit trail. Normal users can never delete these rows.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String?
  actorId        String?
  action         String // CREATE | UPDATE | VOID | APPROVE | REJECT | LOGIN | LOGOUT | PAYMENT | REFUND | ...
  entityType     String
  entityId       String?
  before         String? // JSON snapshot
  after          String? // JSON snapshot
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, outletId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// ============================================================
// Phase 4 — finance
// ============================================================

/// Expense categories per organization (defaults provisioned on first use).
model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
}

/// Non-sale cash in / out of an open drawer (float top-up, cash paid out).
model CashDrawerMovement {
  id             String            @id @default(cuid())
  organizationId String
  outletId       String
  sessionId      String
  session        CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  type           String // PAY_IN | PAY_OUT
  amount         Decimal
  reason         String
  actorId        String?
  idempotencyKey String?
  requestHash    String?
  createdAt      DateTime          @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([sessionId])
  @@index([organizationId, outletId, createdAt])
}

/// Gapless invoice / credit-note counters per outlet, financial year and kind.
model InvoiceSequence {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  fiscalYear     String // "2026-27"
  kind           String // INVOICE | CREDIT_NOTE
  lastNumber     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([outletId, fiscalYear, kind])
}

/// An issued invoice or credit note: immutable tax snapshot (GST-ready data).
model TaxInvoice {
  id                String   @id @default(cuid())
  organizationId    String
  outletId          String
  orderId           String
  kind              String // INVOICE | CREDIT_NOTE
  number            String
  fiscalYear        String
  seq               Int
  /// Exactly-once key: "inv:<orderId>" or "cn:<refundId>".
  sourceKey         String   @unique
  originalInvoiceId String?
  refundId          String?
  issuedAt          DateTime @default(now())
  sellerName        String
  sellerAddress     String?
  sellerGstin       String?
  sellerStateCode   String?
  buyerName         String?
  buyerGstin        String?
  /// State code of the place of supply.
  placeOfSupply     String?
  supplyType        String // INTRA (CGST+SGST) | INTER (IGST) | UNREGISTERED (no GST)
  taxableValue      Decimal
  cgst              Decimal  @default(0)
  sgst              Decimal  @default(0)
  igst              Decimal  @default(0)
  totalTax          Decimal
  total             Decimal
  reason            String?
  createdById       String?

  lines TaxInvoiceLine[]

  @@unique([outletId, number])
  @@index([organizationId, outletId, issuedAt])
  @@index([orderId])
}

model TaxInvoiceLine {
  id             String     @id @default(cuid())
  organizationId String
  invoiceId      String
  invoice        TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ratePct        Decimal
  hsnSac         String?
  taxableValue   Decimal
  cgst           Decimal    @default(0)
  sgst           Decimal    @default(0)
  igst           Decimal    @default(0)

  @@index([invoiceId])
}

// ============================================================
// PHASE 7 — PRINTERS / CASH DRAWER / OUTBOUND INTEGRATIONS
// ============================================================

/// A receipt / KOT printer at an outlet. Transport NETWORK_ESCPOS = raw ESC/POS
/// over TCP to a LAN printer (IP literal in a private range); SIMULATED = no
/// hardware (jobs are rendered and kept, never reported as printed on paper).
model Printer {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  name           String
  /// RECEIPT | KOT
  role           String    @default("RECEIPT")
  /// KOT printers: the kitchen station they print for (null = every station).
  station        String?
  /// NETWORK_ESCPOS | SIMULATED
  transport      String    @default("SIMULATED")
  host           String?
  port           Int       @default(9100)
  /// Characters per line (58 mm = 32, 80 mm = 42/48).
  width          Int       @default(42)
  /// A cash drawer is wired to this printer's kick port.
  cashDrawer     Boolean   @default(false)
  /// KOT printers: print new tickets automatically.
  autoPrint      Boolean   @default(true)
  active         Boolean   @default(true)
  /// ONLINE | OFFLINE | UNKNOWN (last probe / job)
  lastStatus     String    @default("UNKNOWN")
  lastError      String?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  jobs PrintJob[]

  @@unique([outletId, name])
  @@index([organizationId, outletId])
}

/// One print (or drawer-kick) attempt series. dedupeKey makes the FIRST print of
/// a receipt / KOT on a printer happen once; reprints are separate, audited jobs.
model PrintJob {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  printerId      String
  printer        Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  /// RECEIPT | KOT | TEST | DRAWER
  kind           String
  sourceType     String?
  sourceId       String?
  dedupeKey      String
  /// QUEUED | PRINTED | SIMULATED | FAILED
  status         String    @default("QUEUED")
  attempts       Int       @default(0)
  lastError      String?
  /// Rendered text (no secrets; what was / would be printed).
  content        String
  reprintOfId    String?
  reason         String?
  requestedById  String?
  createdAt      DateTime  @default(now())
  printedAt      DateTime?

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, outletId, status])
  @@index([sourceType, sourceId])
  @@index([printerId])
}

/// Outbound integration work (customer messages, aggregator status pushes,
/// accounting vouchers): idempotent per (organization, idempotencyKey), with a
/// bounded attempt count and the provider's reference / failure reason.
model IntegrationDelivery {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String?
  /// MESSAGE | AGGREGATOR_STATUS | ACCOUNTING_VOUCHER
  kind           String
  provider       String
  /// MOCK | SANDBOX | LIVE — fixed when the delivery is created
  mode           String
  idempotencyKey String
  /// Masked destination (e.g. +91******3210); never a credential.
  target         String?
  /// Secret-free JSON of what is / was sent.
  payload        String
  /// PENDING | SENT | DELIVERED | FAILED | SKIPPED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextAttemptAt  DateTime?
  lastError      String?
  providerRef    String?
  sourceType     String?
  sourceId       String?
  batchId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sentAt         DateTime?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, kind, status])
  @@index([provider, providerRef])
}
