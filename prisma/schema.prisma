  notes          String?
  createdById    String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())

  lines InventoryTransferLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([fromOutletId])
  @@index([toOutletId])
}

model InventoryTransferLine {
