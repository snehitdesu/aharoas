# ============================================================
# Aharos — Environment Variables (example)
# Copy to .env and adjust. NEVER commit .env.
# ============================================================

# --- Database ---
# Local development uses SQLite (zero external services required).
DATABASE_URL="file:./dev.db"
# For production, switch prisma/schema.prisma provider to "postgresql" and use:
# DATABASE_URL="postgresql://user:password@host:5432/aharos?schema=public"

# --- Auth ---
# Currently UNUSED: sessions are opaque random tokens stored hashed in the DB
# (no signed cookies/JWTs). Kept for a future signed-token feature.
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32chars-min"
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS="604800"

# --- First-owner bootstrap (npm run bootstrap:owner; EMPTY database only) ---
# Set only for the one-time run, then remove. The password is read from stdin
# (--password-stdin) or a hidden prompt; BOOTSTRAP_OWNER_PASSWORD is a fallback.
# BOOTSTRAP_ORG_NAME="My Restaurant Group"
# BOOTSTRAP_OUTLET_NAME="Main Outlet"
# BOOTSTRAP_OUTLET_CODE="MAIN01"
# BOOTSTRAP_OWNER_NAME="Owner Name"
# BOOTSTRAP_OWNER_EMAIL="owner@example.com"
# BOOTSTRAP_TIMEZONE="Asia/Kolkata"
# BOOTSTRAP_CURRENCY="INR"

# --- Integrations (adapters default to MOCK when unset) ---
# POS provider: "mock" | "petpooja"
POS_PROVIDER="mock"
PETPOOJA_APP_KEY=""
PETPOOJA_APP_SECRET=""
PETPOOJA_WEBHOOK_SECRET=""

# Payment provider: "mock" | "razorpay" (razorpay is a SKELETON: needs real credentials + adapter work)
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"

# Aggregators (only MOCK adapters exist; real Zomato/Swiggy partner APIs are not integrated)
AGGREGATOR_WEBHOOK_SECRET="dev-webhook-secret"

# Mock providers use well-known dev secrets and are REFUSED when NODE_ENV=production
# unless this is set explicitly (never do that on a public deployment).
ALLOW_MOCK_PROVIDERS="false"

# Notifications (adapters default to console/log when unset)
WHATSAPP_PROVIDER="mock"
EMAIL_PROVIDER="mock"

# Google Sheets sync (mock when unset)
GOOGLE_SHEETS_PROVIDER="mock"

# --- Rate limiting ---
# "memory" = per-process (dev / single instance). Multi-instance deployments need
# a shared store (not implemented; "redis" fails loudly).
RATE_LIMIT_STORE="memory"
RATE_LIMIT_DISABLED="false"
# Reverse proxies in front of the app. The client IP (rate limits, audit) is read
# this many X-Forwarded-For entries from the RIGHT (the part our proxies append).
# 1 = one proxy / load balancer (default); 2 = CDN + load balancer.
TRUSTED_PROXY_HOPS="1"

# --- Exports ---
# "inline" = runs export jobs immediately in-process (only runner implemented).
EXPORT_RUNNER="inline"
# Where background export CSVs are written (default: OS temp dir /aharos-exports).
# In production point this at a PERSISTENT, private volume (temp dirs are wiped).
# EXPORT_DIR="/var/lib/aharos/exports"

# --- Tests ---
# Set to a disposable PostgreSQL database to run the suite on PostgreSQL (npm run test:pg).
# TEST_DATABASE_URL="postgresql://user:pass@localhost:5432/aharos_test"
# Same for the browser suite (npm run e2e): a DISPOSABLE PostgreSQL database (it is reset).
# E2E_DATABASE_URL="postgresql://user:pass@localhost:5432/aharos_e2e"
# The demo seed (prisma/seed.ts) deletes ALL data and creates accounts with a public
# password; it refuses in production or on a database with real users unless:
# ALLOW_DEMO_SEED="true"   # disposable databases only — never in production

# --- Ops ---
# Currently UNUSED: there are no cron endpoints (reconciliation and anomaly
# detection are run by signed-in users). Kept for a future scheduler.
CRON_SECRET="dev-cron-secret"
NODE_ENV="development"
