# ============================================================
# Aharos — Environment Variables (example)
# Copy to .env and adjust. NEVER commit .env.
# ============================================================

# Full reference (required/optional, production rules): docs/production-infrastructure.md §2.
# Production validation (src/server/config/env.ts) refuses to start on missing or
# unsafe values; values marked [prod: refused] below are rejected when NODE_ENV=production.

# --- Database ---
# Local development uses SQLite (zero external services required).
DATABASE_URL="file:./dev.db"
# Production (web) runs PostgreSQL: deploy with `npm run db:pg:deploy` (migrate deploy, never db push).
# Connect as the least-privilege APP role (scripts/ops/pg-roles.sql); size the pool explicitly:
# DATABASE_URL="postgresql://restora_app:<password>@db-host:5432/restora?schema=public&sslmode=require&connection_limit=10&pool_timeout=10"

# --- Auth ---
# REQUIRED in production: >= 32 random characters (e.g. `openssl rand -base64 48`).
# Fallback key for encrypting integration secrets when INTEGRATION_SECRETS_KEY is unset.
# The placeholder below is [prod: refused].
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32chars-min"
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS="604800"
# Idle timeout in seconds (optional; default 900 = 15 min for shared POS terminals; example below = 12 h)
# SESSION_IDLE_TIMEOUT_SECONDS="43200"
# Step-up re-authentication grant lifetime (optional)
# REAUTH_TTL_SECONDS="300"

# --- First-owner bootstrap (npm run bootstrap:owner; EMPTY database only) ---
# Set only for the one-time run, then remove. The password is read from stdin
# (--password-stdin) or a hidden prompt; BOOTSTRAP_OWNER_PASSWORD is a fallback.
# BOOTSTRAP_ORG_NAME="My Restaurant Group"
# BOOTSTRAP_OUTLET_NAME="Main Outlet"
# BOOTSTRAP_OUTLET_CODE="MAIN01"
# BOOTSTRAP_OWNER_NAME="Owner Name"
# BOOTSTRAP_OWNER_EMAIL="owner@example.com"
# BOOTSTRAP_TIMEZONE="Asia/Kolkata"
# BOOTSTRAP_CURRENCY="INR"

# --- Integrations (adapters default to MOCK when unset) ---
# POS provider: "mock" | "petpooja"
POS_PROVIDER="mock"
PETPOOJA_APP_KEY=""
PETPOOJA_APP_SECRET=""
PETPOOJA_WEBHOOK_SECRET=""

# Payment provider: "mock" | "razorpay" (razorpay is a SKELETON: needs real credentials + adapter work)
# `*_PROVIDER="mock"` and the "dev-webhook-secret" placeholders are [prod: refused]
# unless ALLOW_MOCK_PROVIDERS=true (non-public test deployments only).
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# Aggregators (only MOCK adapters exist; real Zomato/Swiggy partner APIs are not integrated)
AGGREGATOR_WEBHOOK_SECRET="dev-webhook-secret"

# Public https origin of this deployment (provider status callbacks, e.g. Twilio). Must be https in production.
# PUBLIC_BASE_URL="https://pos.example.com"

# Webhook tenant binding (H4): every webhook is bound to its organization/outlet by an
# Integration connection (Settings → POST /api/master/integrations) keyed by the provider's
# account/store id. A connection may carry its own webhook secret (then the deployment-wide
# secret above is NOT accepted for that tenant); it is stored AES-256-GCM encrypted with a
# key derived from INTEGRATION_SECRETS_KEY (falls back to AUTH_SECRET). Rotating this key
# makes stored tenant secrets unreadable (their webhooks are refused until re-entered).
INTEGRATION_SECRETS_KEY=""

# Mock providers use well-known dev secrets and are REFUSED when NODE_ENV=production
# unless this is set explicitly (never do that on a public deployment).
ALLOW_MOCK_PROVIDERS="false"

# Notifications (adapters default to console/log when unset)
WHATSAPP_PROVIDER="mock"
EMAIL_PROVIDER="mock"
# EMAIL_API_KEY=""

# Google Sheets sync (mock when unset)
GOOGLE_SHEETS_PROVIDER="mock"
# GOOGLE_SHEETS_CLIENT_EMAIL=""
# GOOGLE_SHEETS_PRIVATE_KEY=""

# Network receipt/KOT printers (ESC/POS over TCP): extra allowed ports; loopback for local testing only
# PRINTER_EXTRA_PORTS=""
# PRINTER_ALLOW_LOOPBACK="false"

# --- Rate limiting ---
# "memory" = per-process (dev / single instance). Multi-instance deployments need
# a shared store (not implemented; "redis" fails loudly).
RATE_LIMIT_STORE="memory"
RATE_LIMIT_DISABLED="false"
# Reverse proxies in front of the app. The client IP (rate limits, audit) is read
# this many X-Forwarded-For entries from the RIGHT (the part our proxies append).
# 1 = one proxy / load balancer (default); 2 = CDN + load balancer.
TRUSTED_PROXY_HOPS="1"

# --- Exports ---
# "background" (default) = jobs run in an in-process queue after the request returns;
# "inline" = compatibility mode, the job runs inside the request.
EXPORT_RUNNER="background"
# Hours a finished export stays downloadable before its file is purged (default 168 = 7 days).
EXPORT_RETENTION_HOURS="168"
# Where background export CSVs are written (default: OS temp dir /aharos-exports).
# In production point this at a PERSISTENT, private volume (temp dirs are wiped).
# EXPORT_DIR="/var/lib/aharos/exports"

# --- Observability / operations (docs/production-infrastructure.md) ---
# LOG_LEVEL=debug|info|warn|error (default info); LOG_FORMAT=json|pretty (default json in production)
# LOG_LEVEL="info"
# LOG_FORMAT="json"
# Requests / queries slower than this are logged (ms, default 500). AHAROS_QUERY_TIMING=1 enables query timing outside production.
# SLOW_REQUEST_MS="500"
# Bearer token for GET /api/health/metrics (Prometheus text). Unset = endpoint disabled (404). >= 24 chars.
# METRICS_TOKEN=""
# Alerts are always logged; set an https webhook (Slack/Teams/PagerDuty bridge…) to also POST them.
# ALERT_WEBHOOK_URL=""
# ALERT_THROTTLE_SECONDS="900"
# ALERT_5XX_THRESHOLD="20"                 # server errors per 5 minutes
# ALERT_AUTH_FAILURE_THRESHOLD="50"        # failed sign-ins per 5 minutes
# ALERT_WEBHOOK_FAILURE_THRESHOLD="10"     # failed inbound webhooks per 5 minutes
# Graceful shutdown: keep serving this long after SIGTERM (let the LB see readiness=503), then drain up to TIMEOUT.
# SHUTDOWN_DELAY_MS="0"
# SHUTDOWN_TIMEOUT_MS="25000"
# READINESS_DB_TIMEOUT_MS="2000"
# Maintenance/outbox worker: pass interval; age after which in-progress work counts as interrupted.
# OUTBOX_WORKER_INTERVAL_MS="30000"
# OUTBOX_STUCK_SECONDS="300"
# WEBHOOK_CLAIM_STALE_SECONDS="300"
# EXPORT_STALE_MINUTES="30"
# WORKER_DISABLED="false"
# Backup monitoring: the status file written by scripts/ops/pg-backup.mjs; alert when older than N hours.
# BACKUP_STATUS_FILE="/var/backups/restora/last-backup.json"
# BACKUP_MAX_AGE_HOURS="26"

# --- Backups (scripts/ops/pg-backup.mjs; run by cron/systemd timer, NOT by the app) ---
# BACKUP_DIR="/var/backups/restora"
# 32-byte key, base64 (`openssl rand -base64 32`). Store it OUTSIDE the backup location.
# BACKUP_ENCRYPTION_KEY=""
# BACKUP_RETENTION_DAILY="14"
# BACKUP_RETENTION_WEEKLY="8"
# BACKUP_RETENTION_MONTHLY="12"
# PG_BIN_DIR=""                            # where pg_dump/pg_restore/psql live, if not on PATH

# --- Tests ---
# Set to a disposable PostgreSQL database to run the suite on PostgreSQL (npm run test:pg).
# TEST_DATABASE_URL="postgresql://user:pass@localhost:5432/aharos_test"
# Same for the browser suite (npm run e2e): a FRESH, EMPTY, disposable PostgreSQL database per run (refused if not empty; never reset).
# E2E_DATABASE_URL="postgresql://user:pass@localhost:5432/aharos_e2e"
# The demo seed (prisma/seed.ts) deletes ALL data and creates accounts with a public
# password; it refuses in production or on a database with real users unless:
# ALLOW_DEMO_SEED="true"   # disposable databases only — never in production

# --- Ops ---
# Currently UNUSED: there are no cron endpoints (reconciliation and anomaly
# detection are run by signed-in users). The placeholder is [prod: refused].
CRON_SECRET="dev-cron-secret"
NODE_ENV="development"
