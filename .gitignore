# dependencies
/node_modules
/.pnp
.pnp.js

# next
/.next/
/.next-desktop/
/out/
next-env.d.ts

# production
/build

# env — never commit secrets
.env
.env.local
.env*.local

# database (local sqlite)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# misc
.DS_Store
*.pem
npm-debug.log*
/coverage
.vscode/*
!.vscode/extensions.json

# generated PostgreSQL variant (npm run db:pg:schema) — but its migration
# history is committed: it is the only replayable path to a production database.
/prisma/postgres/*
!/prisma/postgres/migrations/

# Playwright
/e2e/.auth/
/e2e/.results/
/e2e/.report/

# stray local databases / TypeScript incremental build info
/*.db
/*.db-journal
*.tsbuildinfo

# desktop build output (npm run desktop:build / desktop:dist)
/dist-desktop/
/e2e/.results-desktop/

# Backup / DR drill output (encrypted dumps) — never commit
/drill-backups/
*.dump
*.dump.enc
*.dump.partial
